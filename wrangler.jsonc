{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stagesync",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stagesync-db",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_NAME": "midnight"
  },
  "observability": {
    "enabled": true
  }
}
